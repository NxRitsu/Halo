{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAccessibilityUsageDescription" : {
      "comment" : "Privacy - Accessibility Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo reads the position of menu bar items to avoid covering them. This is only used if you choose to show playback when there's room."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo lit la position des éléments de la barre des menus pour éviter de les couvrir. Cet accès ne sert que si vous choisissez d’afficher la lecture quand il y a la place."
          }
        }
      }
    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo controls playback in Music and Spotify when the system's now playing information is unavailable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo contrôle la lecture dans Musique et Spotify quand les informations de lecture du système sont indisponibles."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
