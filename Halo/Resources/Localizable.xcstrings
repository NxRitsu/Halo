    },
    "Temperature unit" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unité de température"
          }
        }
      }
    },
    "The report lists your Mac model, macOS version, displays, %@'s settings and the state of its services. It contains no track, file path or location. Nothing is sent: it is only copied to the clipboard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport indique le modèle de votre Mac, la version de macOS, vos écrans, les réglages de %@ et l’état de ses services. Il ne contient ni morceau, ni chemin de fichier, ni position. Rien n’est envoyé : il est seulement copié dans le presse-papiers."
          }
        }
      }
    },
    "This Mac has no battery." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac n’a pas de batterie."
          }
        }
      }
    },
    "Thunderstorm" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orage"
          }
        }
      }
    },
    "Transparency" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transparence"
          }
        }
      }
    },
    "Turn on %@ in System Settings to measure the menu bar, then reopen it. If it's already on, remove it from the list and add it back. Until then, playback is always shown." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez %@ dans Réglages Système pour mesurer la barre des menus, puis rouvrez-le. S’il est déjà activé, retirez-le de la liste et ajoutez-le à nouveau. En attendant, la lecture reste toujours affichée."
          }
        }
      }
    },
    "Turn them on under Privacy & Security to show the weather." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-le dans Confidentialité et sécurité pour afficher la météo."
          }
        }
      }
    },
