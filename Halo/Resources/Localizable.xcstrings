    },
    "The report lists your Mac model, macOS version, displays, %@'s settings and the state of its services. It contains no track, file path or location. Nothing is sent: it is only copied to the clipboard." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport indique le modèle de votre Mac, la version de macOS, vos écrans, les réglages de %@ et l’état de ses services. Il ne contient ni morceau, ni chemin de fichier, ni position. Rien n’est envoyé : il est seulement copié dans le presse-papiers."
          }
        }
      }
    },
    "This Mac has no battery." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac n’a pas de batterie."
