    "macOS restricts access to what's playing. Halo reads it through a system process (/usr/bin/perl), or falls back to Music and Spotify only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS restreint l’accès à la lecture en cours. Halo la lit via un processus système (/usr/bin/perl), ou se limite à Musique et Spotify en dernier recours."
          }
        }
      }
    },
